# Spotify app client ID (https://developer.spotify.com/dashboard)
# Used only by `npm run sync-playlist`, which runs on your machine.
# The playlists are listed in src/data/playlists.config.json.
SPOTIFY_CLIENT_ID=

# Leaderboard (optional locally). Without these, `npm run dev` keeps scores in
# memory and signs game tickets with a random secret. On Vercel, add the Redis
# integration (it sets KV_REST_API_URL and KV_REST_API_TOKEN) and set
# LEADERBOARD_SECRET to a long random string, e.g. `openssl rand -hex 32`.
KV_REST_API_URL=
KV_REST_API_TOKEN=
LEADERBOARD_SECRET=
