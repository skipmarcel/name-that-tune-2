# Spotify app credentials (https://developer.spotify.com/dashboard)
# Never exposed to the browser. The secret is used only by the server-side
# token endpoint; the client ID is also used by `npm run sync-playlist`.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Playlist to sync tracks from: an ID or share link for a playlist you own
# or collaborate on. Run `npm run sync-playlist` after changing it.
VITE_PLAYLIST_ID=4j9MhzbUmYadbnn4qBJiSC
